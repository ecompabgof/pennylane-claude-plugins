{
  "mcpServers": {
    "pennylane-full": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/../../pennylane-mcp.bundle.mjs"
      ],
      "env": {
        "PENNYLANE_API_TOKEN": "${PENNYLANE_API_TOKEN:-}",
        "MCP_DOMAIN": "full",
        "MCP_SCOPE": "full"
      }
    }
  }
}
